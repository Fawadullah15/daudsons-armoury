# Server Port & Mode
PORT=3053
NODE_ENV=production

# Initial Super Admin Seed (Created on startup if not present)
ADMIN_EMAIL=admin@daudsons.com
ADMIN_PASSWORD=Daudsons@1953#Peshawar

# Relational Database Storage
# Option A: Neon Serverless PostgreSQL / Prisma (Production Cloud)
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: SQLite with Write-Ahead Logging (Local offline fallback)
DATABASE_PATH=./daudsons.db

# Security & Session Secrets
SESSION_SECRET=daudsons_armoury_sovereign_defense_peshawar_1953_entropy_key
SESSION_MAX_AGE_HOURS=8

# Rate Limiting & Protection
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_FORM_ATTEMPTS=10
RATE_LIMIT_FORM_WINDOW_SECONDS=60

# Outbound Transactional Email (Resend or Nodemailer for RFQs & Dealer Enquiries)
SMTP_HOST=smtp.daudsons.com
SMTP_PORT=587
SMTP_USER=no-reply@daudsons.com
SMTP_PASS=SuperSecureAppPasswordGoesHere
EMAIL_FROM=Daudsons Armoury <no-reply@daudsons.com>
EMAIL_SALES=sales@daudsons.com
EMAIL_DEFENSE=defense@daudsons.com

# Media & Storage Adapter (Local by default; S3 or Cloudinary compatible)
MEDIA_STORAGE_DRIVER=local
